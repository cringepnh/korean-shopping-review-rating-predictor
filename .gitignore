# ── Virtual environment ──
.venv/
venv/
env/

# ── Python cache ──
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── Large tokenized data (regenerate with prepare_data.py) ──
data/train.pt
data/val.pt
data/test.pt

# ── Model weights (hosted on HuggingFace) ──
models/*/best_model.pt
models/*/checkpoint_latest.pt

# ── Training completion markers (local only) ──
models/*/training_complete.json

# ── IDE / OS ──
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
